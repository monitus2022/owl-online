# Copy to .env and fill in. Never commit .env.
# All settings use the OWL_ prefix (see app/config.py).

# Which provider adapter to use: bedrock | openrouter (openrouter is the V1 path)
OWL_PROVIDER=openrouter

# Embedder: local (Ollama, dev) or bedrock (Titan, cloud). The index must be
# built with the same provider.
OWL_EMBEDDER_PROVIDER=local
OWL_OLLAMA_BASE_URL=http://localhost:11434
OWL_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
OWL_BEDROCK_EMBED_DIMS=1024

# OpenRouter
OWL_OPENROUTER_API_KEY=

# Amazon Bedrock (reranker and V2 Llm). Credentials come from the standard AWS
# chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or ~/.aws/credentials).
OWL_AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Llm (V2). Used when OWL_PROVIDER=bedrock. The model must be available
# in OWL_AWS_REGION; probe it with scripts/probe_bedrock.py before deploying.
OWL_BEDROCK_LLM_MODEL=qwen.qwen3-32b-v1:0
OWL_BEDROCK_LLM_MAX_TOKENS=1024

# Deterministic verification retries per answer (0 disables). The chat answer
# path retries once when a draft is empty or cites nothing.
OWL_RETRY_BUDGET=1

# Deadline for one /ask request, in seconds (retrieve plus generate). The
# streaming endpoint is not bounded.
OWL_ASK_TIMEOUT_S=30

# Chat cost controls (#88). Anonymous limits; auth later moves them to a user id.
# Counters live in one process, so a restart resets the windows.
OWL_CHAT_PER_MINUTE=10
OWL_CHAT_PER_DAY=100
OWL_CHAT_IP_PER_DAY=100
OWL_CHAT_CONCURRENT=2
OWL_CHAT_DAILY_TOKEN_BUDGET=200000
OWL_CHAT_CACHE_ENTRIES=256
OWL_CHAT_CACHE_TTL_S=3600
# Placeholder prices for the pinned generator; set to your contract.
OWL_CHAT_INPUT_PRICE_PER_MTOK=0.10
OWL_CHAT_OUTPUT_PRICE_PER_MTOK=0.30
# Signs the anonymous session cookie. Set a long random value in production;
# empty means a random per-process secret, so sessions reset on restart.
OWL_SESSION_SECRET=
# CIDRs whose client-IP headers are trusted (loopback plus the Docker bridge).
OWL_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.17.0.1/32

# Model routing. Off keeps one model on every intent. "intent" sends practice
# and feedback to the small model; answers keep the main model.
OWL_ROUTING=off
OWL_SMALL_PROVIDER=openrouter
OWL_SMALL_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Request traces. Empty means stdout only; set a path for a size-capped JSONL
# file. Prompts are stored as hashes, never as text.
OWL_TRACE_FILE=
OWL_TRACE_MAX_BYTES=20000000

# Reranking (V1). Set OWL_RERANK_PROVIDER=none to disable.
OWL_RERANK_PROVIDER=bedrock
OWL_RERANK_MODEL=amazon.rerank-v1:0
OWL_RERANK_POOL=50
# Per-retrieval-leg candidate quota for decomposed questions. 0 keeps global
# fusion; 2 is the #96 experiment value, not the default.
OWL_SUBQUERY_QUOTA=0

# Logging
OWL_LOG_LEVEL=INFO

# Browser origins allowed by CORS (comma-separated). Cloudflare Pages previews
# are matched by OWL_CORS_ORIGIN_REGEX.
OWL_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
OWL_CORS_ORIGIN_REGEX=https://.*\.pages\.dev

# Tests: opt in to real provider calls (default off; tests stay hermetic)
OWL_LIVE_TESTS=0

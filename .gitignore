# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.uv/

# Secrets and local env
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/

# Web frontend (Vite/React in web/)
web/node_modules/
# The dev-mode env file holds only public local defaults, so it is committed.
!web/.env.development

# Corpus and derived data: copyrighted source text must stay out of git.
data/*
!data/.gitkeep
/data/**/*.jsonl

# The gold set is original content and is published.
!eval/gold/**/*.jsonl

# Eval artifacts: timestamped runs stay local; the pinned baseline is committed.
eval/results/*.csv
!eval/results/baseline.csv
eval/results/persona-*.json
eval/results/rag-*.json
!eval/results/rag-baseline.json
eval/results/rag-calibration-*.json
eval/.cache/

# Notebooks
notebooks/.ipynb_checkpoints/

# OS and editor
.DS_Store
.idea/
.vscode/

# Browser E2E (Playwright)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
